# Rendered by the nginx image's envsubst entrypoint: ${SERVER_NAME},
# ${BACKEND_HOST} and ${BACKEND_PORT} come from the container environment.
# nginx runtime variables ($host, $uri, ...) are left untouched — envsubst only
# replaces names that exist in the environment.
server {
    listen 80;
    server_name ${SERVER_NAME} localhost;

    root /usr/share/nginx/html;
    index index.html;

    # The single door to the backend. Angular calls relative /api/v1/... and
    # this forwards it to the API service, so browser and API share an origin.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Static Storybook of the shared UI primitives. Deep links fall back to
    # Storybook's own index (it drives navigation via ?path= query params).
    location /storybook/ {
        alias /usr/share/nginx/html/storybook/;
        index index.html;
        try_files $uri $uri/ /storybook/index.html;
    }

    # SPA fallback: unknown paths return index.html so client routing works.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
