# Frontend container settings — copied to .env by ./run.sh, loaded into the
# nginx container and applied to its config template via envsubst at start-up.

# server_name for the vhost (matches APP_HOST in the root .env).
SERVER_NAME=teachassignment.local

# Where nginx forwards /api/ — the backend service on the compose network.
BACKEND_HOST=backend
BACKEND_PORT=8000
