# Compose orchestration for Librarium — copied to .env by ./run.sh.
# These values drive docker-compose interpolation (ports, DB, public host).

# Public hostname the app is served under. ./run.sh adds it to /etc/hosts.
APP_HOST=teachassignment.local

# Published port for the SPA (the single door: static app + /api proxy).
APP_PORT=8080

# Published port for the API, for hitting the backend directly if you want.
BACKEND_PORT=8000

# Published MariaDB port on the host (container-side is always 3306).
DB_PORT=3306

# Laravel application key. ./run.sh fills this in if left empty.
APP_KEY=

# MariaDB credentials. The backend connects to host "db" on the compose network.
DB_DATABASE=librarium
DB_USERNAME=librarium
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
